        'wardrobe_cabinet',
        'coffee_machine',
        'barista_counter',
        'bistro_table',
        'bistro_chair',
        'vending_machine',
        'pastry_display',
        'poker_table',
        'roulette_table',
        'slot_machine',
        'craps_table',
        'poker_chips',
        'pool_lounger',
        'cabana_canopy',
