rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Shared Hardened Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidChatId(id) {
      return id is string && id.size() >= 3 && id.size() <= 260 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsername(name) {
      return name is string && name.size() >= 3 && name.size() <= 16 && name.matches('^[a-zA-Z0-9]+$');
    }

    function isValidLowerUsername(name) {
      return name is string && name.size() >= 3 && name.size() <= 16 && name.matches('^[a-z0-9]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isHexColor(val) {
      return val is string && val.size() == 7 && val.matches('^#[0-9a-fA-F]{6}$');
    }

    function isValidHairStyle(style) {
      return style is string && style in [
        'buzz', 'spiky', 'bob', 'long_waves', 'pompadour',
        'undercut', 'braids', 'curls', 'afro', 'man_bun',
        'side_part', 'curly_crop', 'slick_back', 'fade', 'tousled',
        'pigtails', 'afro_puff', 'beach_waves', 'pixie', 'chignon',
        'high_ponytail', 'curtain_bangs'
      ];
    }

    function isClubOnlyHairStyle(style) {
      return style in ['braids', 'curls'];
    }

    function isCustomWardrobeHairStyle(style) {
      return style == 'afro';
    }

    function isValidHatStyle(hat) {
      return hat is string && hat in [
        'none', 'snapback', 'beanie', 'headphones', 'fedora',
        'beret', 'tophat', 'crown', 'halo', 'fascinator', 'cloche'
      ];
    }

    function isClubOnlyHatStyle(hat) {
      return hat in ['tophat', 'crown', 'halo', 'fascinator', 'cloche'];
    }

    function isValidTopStyle(style) {
      return style is string && style in [
        'tshirt', 'hoodie', 'suit', 'leather', 'tank', 'crop',
        'polo', 'turtleneck', 'silk_shirt', 'henley', 'varsity',
        'tuxedo', 'cashmere', 'halter', 'silk_blouse'
      ];
    }

    function isValidBottomStyle(style) {
      return style is string && style in [
        'jeans', 'shorts', 'skirt', 'slacks', 'chinos', 'cargo', 'midi_skirt'
      ];
    }

    function isValidShoeStyle(style) {
      return style is string && style in [
        'sneakers', 'boots', 'loafers', 'dress_shoes', 'espadrilles', 'heels', 'oxfords'
      ];
    }

    function isValidClothPattern(pat) {
      return pat is string && pat in ['none', 'tie_dye', 'checkerboard', 'camo', 'starfield'];
    }

    function isClubOnlyTopColor(hex) {
      return hex in ['#00f5d4', '#ff2a85', '#ffd166', '#e5e7eb', '#a3e635', '#9333ea'];
    }

    function isActiveClubUserDoc(data) {
      return ('isClubMember' in data)
        && data.isClubMember == true
        && ('clubExpiresAt' in data)
        && data.clubExpiresAt is timestamp
        && data.clubExpiresAt > request.time;
    }

    function hasCustomWardrobeDoc(data) {
      return (('hasCustomWardrobe' in data) && data.hasCustomWardrobe == true)
        || (('staffRole' in data) && data.staffRole in ['owner', 'super_admin']);
    }

    function hasSpecialtyFurniDoc(data) {
      return (('hasSpecialtyFurni' in data) && data.hasSpecialtyFurni == true)
        || (('staffRole' in data) && data.staffRole in ['owner', 'super_admin']);
    }

    function isSignedInUserClubMember() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && isActiveClubUserDoc(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    function isSignedInUserSpecialtyUnlocked() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && hasSpecialtyFurniDoc(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    // 20x20 grid coordinate limit (0..19 for Owner Sanctuary and all smaller layouts)
    function isValidCoord(val) {
      return (val is int || val is float) && val >= 0 && val <= 19;
    }

    function isValidPlayerCoord(x, y) {
      return (x == -1 && y == 0) || (isValidCoord(x) && isValidCoord(y));
    }

    function isValidDirection(dir) {
      return dir is string && dir in ['NE', 'NW', 'SE', 'SW'];
    }

    function isValidDrink(drink) {
      return drink is string && drink in [
        'none', 'martini', 'whiskey', 'beer', 'shot', 'cocktail', 'espresso', 'soda'
      ];
    }

    function isValidEmote(emote) {
      return emote is string && emote in ['none', 'wave', 'dance', 'laugh', 'afk'];
    }

    function isValidAvatar(avatar) {
      return avatar is map
        && avatar.keys().hasAll(['skin', 'hair', 'top', 'bottom', 'hairStyle'])
        && avatar.keys().hasOnly([
          'gender', 'skin', 'hair', 'eyeColor', 'top', 'bottom', 'hairStyle',
          'hat', 'topStyle', 'bottomStyle', 'shoeStyle', 'shoeColor', 'clothPattern',
          'hairId', 'topId', 'bottomId', 'footwearId', 'accessoryId', 'auraEffect'
        ])
        && (!('gender' in avatar) || (avatar.gender is string && avatar.gender in ['male', 'female']))
        && isHexColor(avatar.skin)
        && isHexColor(avatar.hair)
        && (!('eyeColor' in avatar) || isHexColor(avatar.eyeColor))
        && isHexColor(avatar.top)
        && isHexColor(avatar.bottom)
        && isValidHairStyle(avatar.hairStyle)
        && (!('hat' in avatar) || isValidHatStyle(avatar.hat))
        && (!('topStyle' in avatar) || isValidTopStyle(avatar.topStyle))
        && (!('bottomStyle' in avatar) || isValidBottomStyle(avatar.bottomStyle))
        && (!('shoeStyle' in avatar) || isValidShoeStyle(avatar.shoeStyle))
        && (!('shoeColor' in avatar) || isHexColor(avatar.shoeColor))
        && (!('clothPattern' in avatar) || isValidClothPattern(avatar.clothPattern))
        && (!('hairId' in avatar) || (avatar.hairId is string && avatar.hairId.size() <= 48))
        && (!('topId' in avatar) || (avatar.topId is string && avatar.topId.size() <= 48))
        && (!('bottomId' in avatar) || (avatar.bottomId is string && avatar.bottomId.size() <= 48))
        && (!('footwearId' in avatar) || (avatar.footwearId is string && avatar.footwearId.size() <= 48))
        && (!('accessoryId' in avatar) || (avatar.accessoryId is string && avatar.accessoryId.size() <= 48))
        && (!('auraEffect' in avatar) || (avatar.auraEffect is string && avatar.auraEffect in ['none', 'diamond']));
    }

    function hasClubAccessForAvatar(userData, avatar) {
      let hasClub = isActiveClubUserDoc(userData);
      let hasWardrobe = hasCustomWardrobeDoc(userData);
      let ownedIds = userData.get('ownedWardrobeIds', []);
      let hairUnlocked = ('hairId' in avatar) && (avatar.hairId in ownedIds);
      let accUnlocked = ('accessoryId' in avatar) && (avatar.accessoryId in ownedIds);
      let topUnlocked = ('topId' in avatar) && (avatar.topId in ownedIds);
      return (hasClub || hasWardrobe || hairUnlocked || !isClubOnlyHairStyle(avatar.hairStyle))
        && (hasWardrobe || hairUnlocked || !isCustomWardrobeHairStyle(avatar.hairStyle))
        && (hasClub || hasWardrobe || accUnlocked || !('hat' in avatar) || !isClubOnlyHatStyle(avatar.hat))
        && (hasClub || hasWardrobe || topUnlocked || !isClubOnlyTopColor(avatar.top))
        && (hasWardrobe || !('clothPattern' in avatar) || avatar.clothPattern == 'none')
        && (hasClub || isTargetOwnerDoc(userData) || !('auraEffect' in avatar) || avatar.auraEffect == 'none');
    }

    function isValidWallTheme(theme) {
      return theme is string && theme in [
        'art_deco_brass',
        'mahogany_lobby',
        'sapphire_salon',
        'emerald_terrace',
        'casino_gilded',
        'sunlit_loft',
        'cozy_cafe',
        'apartment_warm',
        'game_arena',
        'dark_slate_neon',
        'exposed_brick_club',
        'velvet_crimson',
        'midnight_penthouse',
        'cyber_grid'
      ];
    }

    function isValidFloorTheme(theme) {
      return theme is string && theme in [
        'veined_marble_gold',
        'art_deco_chevron',
        'emerald_terrazzo',
        'sapphire_carpet',
        'ivory_travertine',
        'oak_parquet',
        'cafe_terracotta',
        'sunlit_tile',
        'arena_turf',
        'checkered_marble',
        'dark_hardwood',
        'glowing_club_tiles',
        'plush_burgundy_carpet',
        'concrete_loft'
      ];
    }

    function isValidLayoutType(layout) {
      return layout is string && layout in [
        'cozy_studio',
        'classic_lounge',
        'l_shaped_vip',
        'grand_penthouse',
        'vip_duplex_loft',
        'vip_sky_atrium',
        'owner_sanctuary'
      ];
    }

    function isVipLayoutType(layout) {
      return layout in ['vip_duplex_loft', 'vip_sky_atrium'];
    }

    function isValidAccessMode(mode) {
      return mode is string && mode in ['open', 'doorbell', 'password'];
    }

    function isValidAmbientDim(dim) {
      return (dim is int || dim is float) && dim >= 0 && dim <= 70;
    }

    function isSystemPublicRoomId(roomId) {
      return roomId in [
        'velvet_lobby', 'rooftop_bar', 'vip_speakeasy',
        'turf_wars_arena', 'rapid_chairs_hall', 'grand_parlor_casino'
      ];
    }

    function isRoomOwner(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId))
        && get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid;
    }

    function isSandboxRoom(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId))
        && get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == 'system';
    }

    function isOpenBuildRoom(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId))
        && get(/databases/$(database)/documents/rooms/$(roomId)).data.get('allowVisitorBuild', false) == true;
    }

    function isRoomModerator(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId))
        && 'moderators' in get(/databases/$(database)/documents/rooms/$(roomId)).data
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.moderators;
    }

    function isRoomHost(roomId) {
      return isRoomModerator(roomId)
        || (
          exists(/databases/$(database)/documents/rooms/$(roomId))
          && 'hosts' in get(/databases/$(database)/documents/rooms/$(roomId)).data
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.hosts
        );
    }

    function isRoomBuilder(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId))
        && 'builders' in get(/databases/$(database)/documents/rooms/$(roomId)).data
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.builders;
    }

    function isBannedFromRoom(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId))
        && 'bannedUsers' in get(/databases/$(database)/documents/rooms/$(roomId)).data
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.bannedUsers;
    }

    function isSilencedInRoom(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId))
        && 'silencedUsers' in get(/databases/$(database)/documents/rooms/$(roomId)).data
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.silencedUsers
        && get(/databases/$(database)/documents/rooms/$(roomId)).data.silencedUsers[request.auth.uid] > request.time.toMillis();
    }

    function isValidStaffRole(role) {
      return role is string && role in ['user', 'moderator', 'gm', 'admin', 'owner', 'super_admin'];
    }

    function isCallerStaffRoleIn(roles) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && ('staffRole' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffRole in roles;
    }

    function isGlobalModOrAbove() {
      return isCallerStaffRoleIn(['moderator', 'gm', 'admin', 'owner', 'super_admin']);
    }

    function isGlobalGmOrAbove() {
      return isCallerStaffRoleIn(['gm', 'admin', 'owner', 'super_admin']);
    }

    function isGlobalAdmin() {
      return isCallerStaffRoleIn(['admin', 'owner', 'super_admin']);
    }

    function isOwner() {
      return isCallerStaffRoleIn(['owner', 'super_admin']);
    }

    function canManageRoomFurniture(roomId) {
      return isRoomOwner(roomId) || isGlobalGmOrAbove() || isOpenBuildRoom(roomId) || isRoomBuilder(roomId);
    }

    function isTargetOwnerDoc(data) {
      return ('staffRole' in data) && data.staffRole in ['owner', 'super_admin'];
    }

    function isCallerGloballyBanned() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && ('isBanned' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned == true
        && (
          !('tempBanUntilMs' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tempBanUntilMs == 0
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tempBanUntilMs > request.time.toMillis()
        );
    }

    function isCallerGloballyMuted() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && ('isMuted' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isMuted == true;
    }

    function isEconomyFrozen() {
      return (
        exists(/databases/$(database)/documents/server_state/config)
        && get(/databases/$(database)/documents/server_state/config).data.get('economyFreeze', false) == true
      ) || (
        exists(/databases/$(database)/documents/app_meta/config)
        && get(/databases/$(database)/documents/app_meta/config).data.get('economyFreeze', false) == true
      );
    }

    function isValidCustomSpriteSpec(spec) {
      return spec is map
        && spec.keys().hasAll(['shape', 'primaryHex', 'secondaryHex', 'glowHex', 'pattern'])
        && spec.keys().hasOnly(['shape', 'primaryHex', 'secondaryHex', 'glowHex', 'pattern'])
        && spec.shape in ['chair', 'table', 'lamp', 'pillar', 'rug']
        && isHexColor(spec.primaryHex)
        && isHexColor(spec.secondaryHex)
        && isHexColor(spec.glowHex)
        && spec.pattern in ['solid', 'tie_dye', 'checkerboard', 'starfield'];
    }

    function isValidFurnitureVariantSpec(spec) {
      return spec is map
        && spec.keys().hasAll(['finishId', 'primaryHex', 'secondaryHex', 'accentHex', 'material'])
        && spec.keys().hasOnly(['finishId', 'primaryHex', 'secondaryHex', 'accentHex', 'material', 'artworkIndex'])
        && spec.finishId is string && spec.finishId.size() <= 48
        && isHexColor(spec.primaryHex)
        && isHexColor(spec.secondaryHex)
        && isHexColor(spec.accentHex)
        && spec.material is string && spec.material.size() <= 32
        && (!('artworkIndex' in spec) || (spec.artworkIndex is int && spec.artworkIndex >= 0 && spec.artworkIndex <= 200));
    }

    function isValidUserProfile(data, uid) {
      return data.keys().hasAll([
          'uid', 'username', 'credits', 'tokens',
          'lastDailyClaim', 'avatar', 'createdAt'
        ])
        && data.keys().hasOnly([
          'uid', 'username', 'motto', 'staffRole', 'isOnDuty',
          'isBanned', 'tempBanUntilMs', 'banReason', 'isMuted',
          'hasCustomWardrobe', 'hasSpecialtyFurni', 'eloRating', 'turfRating',
          'summonRoomId', 'summonRoomName', 'summonBy', 'summonAt',
          'credits', 'tokens', 'memberPoints', 'memberTenureMonths',
          'claimedTierRewards', 'ownedWardrobeIds',
          'isClubMember', 'clubExpiresAt',
          'lastDailyClaim', 'lastClaimAt', 'lastChatAt',
          'avatar', 'createdAt', 'lastTradeId'
        ])
        && isValidId(data.uid)
        && data.uid == uid
        && isValidUsername(data.username)
        && (!('motto' in data) || (data.motto is string && data.motto.size() <= 50))
        && (!('staffRole' in data) || isValidStaffRole(data.staffRole))
        && (!('isOnDuty' in data) || data.isOnDuty is bool)
        && (!('isBanned' in data) || data.isBanned is bool)
        && (!('tempBanUntilMs' in data) || ((data.tempBanUntilMs is int || data.tempBanUntilMs is float) && data.tempBanUntilMs >= 0))
        && (!('banReason' in data) || (data.banReason is string && data.banReason.size() <= 160))
        && (!('isMuted' in data) || data.isMuted is bool)
        && (!('hasCustomWardrobe' in data) || data.hasCustomWardrobe is bool)
        && (!('hasSpecialtyFurni' in data) || data.hasSpecialtyFurni is bool)
        && (!('eloRating' in data) || (data.eloRating is int && data.eloRating >= 0 && data.eloRating <= 5000))
        && (!('turfRating' in data) || (data.turfRating is int && data.turfRating >= 0 && data.turfRating <= 5000))
        && (!('summonRoomId' in data) || (data.summonRoomId is string && data.summonRoomId.size() <= 128))
        && (!('summonRoomName' in data) || (data.summonRoomName is string && data.summonRoomName.size() <= 36))
        && (!('summonBy' in data) || (data.summonBy is string && data.summonBy.size() <= 24))
        && (!('summonAt' in data) || ((data.summonAt is int || data.summonAt is float) && data.summonAt >= 0))
        && data.credits is int
        && data.credits >= 0
        && data.credits <= 1000000
        && data.tokens is int
        && data.tokens >= 0
        && data.tokens <= 10000000
        && (!('memberPoints' in data) || (data.memberPoints is int && data.memberPoints >= 0 && data.memberPoints <= 10000000))
        && (!('memberTenureMonths' in data) || (data.memberTenureMonths is int && data.memberTenureMonths >= 0 && data.memberTenureMonths <= 240))
        && (!('claimedTierRewards' in data) || (data.claimedTierRewards is list && data.claimedTierRewards.size() <= 10 && (data.claimedTierRewards.size() == 0 || data.claimedTierRewards[0] is string)))
        && (!('ownedWardrobeIds' in data) || (data.ownedWardrobeIds is list && data.ownedWardrobeIds.size() <= 300 && (data.ownedWardrobeIds.size() == 0 || data.ownedWardrobeIds[0] is string)))
        && (!('isClubMember' in data) || data.isClubMember is bool)
        && (!('clubExpiresAt' in data) || data.clubExpiresAt is timestamp)
        && data.lastDailyClaim is timestamp
        && (!('lastClaimAt' in data) || data.lastClaimAt is timestamp)
        && (!('lastChatAt' in data) || data.lastChatAt is timestamp)
        && isValidAvatar(data.avatar)
        && (!('lastTradeId' in data) || isValidId(data.lastTradeId))
        && data.createdAt is timestamp;
    }

    function isValidStaffLog(data, logId) {
      return data.keys().hasAll([
          'id', 'actorUid', 'actorName', 'action',
          'targetUid', 'targetName', 'details', 'timestamp'
        ])
        && data.keys().hasOnly([
          'id', 'actorUid', 'actorName', 'action',
          'targetUid', 'targetName', 'details', 'timestamp'
        ])
        && isValidId(data.id)
        && data.id == logId
        && isValidId(data.actorUid)
        && data.actorName is string
        && data.actorName.size() >= 1
        && data.actorName.size() <= 24
        && data.action is string
        && data.action in [
          'ban', 'temp_ban', 'unban', 'mute', 'unmute', 'room_kick',
          'grant_credits', 'grant_tokens', 'deduct_wallet', 'grant_vip',
          'grant_unlock', 'role_change', 'report_resolved', 'server_control',
          'catalog_create', 'event_launch', 'chest_drop'
        ]
        && isValidId(data.targetUid)
        && data.targetName is string
        && data.targetName.size() >= 1
        && data.targetName.size() <= 24
        && data.details is string
        && data.details.size() >= 1
        && data.details.size() <= 200
        && data.timestamp is timestamp;
    }

    function isValidInventoryItem(data, itemId) {
      return data.keys().hasAll(['itemId', 'type', 'name', 'walkable', 'isTradable', 'acquiredAt'])
        && data.keys().hasOnly([
          'itemId', 'type', 'name', 'walkable', 'isTradable',
          'catalogId', 'isClubOnly', 'variantSpec', 'customSpriteSpec', 'acquiredAt'
        ])
        && isValidId(data.itemId)
        && data.itemId == itemId
        && isValidFurnitureType(data.type)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 48
        && data.walkable is bool
        && data.isTradable is bool
        && data.isTradable == true
        && (!('catalogId' in data) || (data.catalogId is string && data.catalogId.size() <= 64))
        && (!('isClubOnly' in data) || data.isClubOnly is bool)
        && (!('variantSpec' in data) || isValidFurnitureVariantSpec(data.variantSpec))
        && (!('customSpriteSpec' in data) || isValidCustomSpriteSpec(data.customSpriteSpec))
        && data.acquiredAt is timestamp
        && data.acquiredAt == request.time;
    }

    function isValidFriendLink(data, friendUid) {
      return data.keys().hasAll(['uid', 'username', 'status', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'username', 'status', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == friendUid
        && isValidUsername(data.username)
        && data.status is string
        && data.status in ['pending_incoming', 'pending_outgoing', 'accepted']
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidPlayerStatus(data, uid) {
      return data.keys().hasAll(['uid', 'username', 'currentRoomId', 'currentRoomName', 'isOnline', 'lastSeen'])
        && data.keys().hasOnly(['uid', 'username', 'currentRoomId', 'currentRoomName', 'isOnline', 'lastSeen'])
        && isValidId(data.uid)
        && data.uid == uid
        && data.uid == request.auth.uid
        && isValidUsername(data.username)
        && isValidId(data.currentRoomId)
        && data.currentRoomName is string
        && data.currentRoomName.size() >= 1
        && data.currentRoomName.size() <= 36
        && data.isOnline is bool
        && data.lastSeen is timestamp
        && data.lastSeen == request.time;
    }

    function isValidTradeOffer(offer) {
      return offer is map
        && offer.keys().hasAll(['credits', 'tokens', 'items'])
        && offer.keys().hasOnly(['credits', 'tokens', 'items'])
        && offer.credits is int
        && offer.credits >= 0
        && offer.credits <= 1000000
        && offer.tokens is int
        && offer.tokens >= 0
        && offer.tokens <= 10000000
        && offer.items is list
        && offer.items.size() <= 4
        && (offer.items.size() == 0 || offer.items[0] is map);
    }

    function isValidTrade(data, tradeId) {
      return data.keys().hasAll([
          'id', 'roomId', 'uidA', 'usernameA', 'uidB', 'usernameB',
          'participantIds', 'status', 'offerA', 'offerB',
          'acceptA', 'acceptB', 'confirmA', 'confirmB', 'syncedA', 'syncedB',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'roomId', 'uidA', 'usernameA', 'uidB', 'usernameB',
          'participantIds', 'status', 'offerA', 'offerB',
          'acceptA', 'acceptB', 'confirmA', 'confirmB', 'syncedA', 'syncedB',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == tradeId
        && isValidId(data.roomId)
        && isValidId(data.uidA)
        && isValidUsername(data.usernameA)
        && isValidId(data.uidB)
        && isValidUsername(data.usernameB)
        && data.uidA != data.uidB
        && data.participantIds is list
        && data.participantIds.size() == 2
        && data.uidA in data.participantIds
        && data.uidB in data.participantIds
        && data.status is string
        && data.status in ['open', 'completed', 'cancelled']
        && isValidTradeOffer(data.offerA)
        && isValidTradeOffer(data.offerB)
        && data.acceptA is bool
        && data.acceptB is bool
        && data.confirmA is bool
        && data.confirmB is bool
        && data.syncedA is bool
        && data.syncedB is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidPrivateChat(data, chatId) {
      return data.keys().hasAll([
          'id', 'participantIds', 'participantNames',
          'lastMessageText', 'lastSenderUid', 'readBy', 'lastMessageAt'
        ])
        && data.keys().hasOnly([
          'id', 'participantIds', 'participantNames',
          'lastMessageText', 'lastSenderUid', 'readBy', 'lastMessageAt'
        ])
        && isValidChatId(data.id)
        && data.id == chatId
        && data.participantIds is list
        && data.participantIds.size() == 2
        && data.participantIds[0] is string
        && data.participantIds[1] is string
        && data.participantIds[0] != data.participantIds[1]
        && data.participantNames is map
        && data.lastMessageText is string
        && data.lastMessageText.size() <= 500
        && isValidId(data.lastSenderUid)
        && data.readBy is map
        && data.lastMessageAt is timestamp;
    }

    function isValidPrivateMessage(data) {
      return data.keys().hasAll(['senderUid', 'senderName', 'participantIds', 'text', 'createdAt'])
        && data.keys().hasOnly(['senderUid', 'senderName', 'participantIds', 'text', 'createdAt'])
        && isValidId(data.senderUid)
        && data.senderUid == request.auth.uid
        && data.senderName is string
        && data.senderName.size() >= 1
        && data.senderName.size() <= 24
        && data.participantIds is list
        && data.participantIds.size() == 2
        && data.participantIds[0] is string
        && data.participantIds[1] is string
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 500
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isChatParticipant(chatId) {
      return exists(/databases/$(database)/documents/private_chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/private_chats/$(chatId)).data.participantIds;
    }

    function isValidUsernameClaim(data, lowercaseName) {
      return data.keys().hasAll(['uid', 'username', 'authEmail', 'createdAt'])
        && data.keys().hasOnly(['uid', 'username', 'authEmail', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidUsername(data.username)
        && data.username.lower() == lowercaseName
        && data.authEmail is string
        && data.authEmail.size() >= 16
        && data.authEmail.size() <= 30
        && data.authEmail.matches('^[a-z0-9]{3,16}@lounge\\.local$')
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidGameMode(mode) {
      return mode is string && mode in [
        'hangout', 'kick_wars', 'maze_race', 'casino_freeplay',
        'turf_wars', 'rapid_chairs', 'parlor_casino'
      ];
    }

    function isValidKickWarsMode(mode) {
      return mode is string && mode in ['ffa', 'team'];
    }

    function isValidKickWarsRange(range) {
      return range is string && range in ['melee', 'open'];
    }

    function isValidPlayerTeam(team) {
      return team is string && team in ['none', 'red', 'blue'];
    }

    function isValidRoom(data, roomId) {
      return data.keys().hasAll([
          'id', 'name', 'ownerId', 'ownerName',
          'isPublic', 'wallTheme', 'floorTheme', 'ambientDim', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'ownerId', 'ownerName',
          'isPublic', 'layoutType', 'accessMode', 'roomPasscode', 'invitedUids',
          'allowWalkThrough', 'allowVisitorBuild',
          'wallTheme', 'floorTheme', 'ambientDim',
          'moderators', 'hosts', 'builders',
          'gameMode', 'groupId', 'kickWarsMode', 'kickWarsRange',
          'matchActive', 'redScore', 'blueScore',
          'bannedUsers', 'silencedUsers', 'createdAt'
        ])
        && isValidId(data.id)
        && data.id == roomId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 36
        && isValidId(data.ownerId)
        && data.ownerName is string
        && data.ownerName.size() >= 1
        && data.ownerName.size() <= 24
        && data.isPublic is bool
        && (!('layoutType' in data) || isValidLayoutType(data.layoutType))
        && (!('accessMode' in data) || isValidAccessMode(data.accessMode))
        && (!('roomPasscode' in data) || (data.roomPasscode is string && data.roomPasscode.size() <= 24))
        && (!('invitedUids' in data) || (data.invitedUids is list && data.invitedUids.size() <= 50 && (data.invitedUids.size() == 0 || data.invitedUids[0] is string)))
        && (!('allowWalkThrough' in data) || data.allowWalkThrough is bool)
        && (!('allowVisitorBuild' in data) || data.allowVisitorBuild is bool)
        && isValidWallTheme(data.wallTheme)
        && isValidFloorTheme(data.floorTheme)
        && isValidAmbientDim(data.ambientDim)
        && (!('moderators' in data) || (data.moderators is list && data.moderators.size() <= 20 && (data.moderators.size() == 0 || data.moderators[0] is string)))
        && (!('hosts' in data) || (data.hosts is list && data.hosts.size() <= 20 && (data.hosts.size() == 0 || data.hosts[0] is string)))
        && (!('builders' in data) || (data.builders is list && data.builders.size() <= 20 && (data.builders.size() == 0 || data.builders[0] is string)))
        && (!('gameMode' in data) || isValidGameMode(data.gameMode))
        && (!('groupId' in data) || (data.groupId is string && data.groupId.size() <= 128 && (data.groupId == '' || isValidId(data.groupId))))
        && (!('kickWarsMode' in data) || isValidKickWarsMode(data.kickWarsMode))
        && (!('kickWarsRange' in data) || isValidKickWarsRange(data.kickWarsRange))
        && (!('matchActive' in data) || data.matchActive is bool)
        && (!('redScore' in data) || (data.redScore is int && data.redScore >= 0 && data.redScore <= 999))
        && (!('blueScore' in data) || (data.blueScore is int && data.blueScore >= 0 && data.blueScore <= 999))
        && (!('bannedUsers' in data) || data.bannedUsers is map)
        && (!('silencedUsers' in data) || data.silencedUsers is map)
        && data.createdAt is timestamp;
    }

    function isValidRoomGroup(data, groupId) {
      return data.keys().hasAll([
          'id', 'name', 'ownerId', 'ownerName',
          'gameType', 'lobbyRoomId', 'arenaRoomIds', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'ownerId', 'ownerName',
          'gameType', 'lobbyRoomId', 'arenaRoomIds', 'createdAt'
        ])
        && isValidId(data.id)
        && data.id == groupId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 36
        && isValidId(data.ownerId)
        && data.ownerName is string
        && data.ownerName.size() >= 1
        && data.ownerName.size() <= 24
        && data.gameType is string
        && data.gameType in ['kick_wars', 'maze_race', 'hangout']
        && isValidId(data.lobbyRoomId)
        && data.arenaRoomIds is list
        && data.arenaRoomIds.size() <= 20
        && (data.arenaRoomIds.size() == 0 || isValidId(data.arenaRoomIds[0]))
        && data.createdAt is timestamp;
    }

    function isValidActiveMatch(data) {
      return data.keys().hasAll([
          'id', 'groupId', 'status', 'startedByUid', 'startedByName',
          'fighters', 'startedAtMs', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'groupId', 'status', 'startedByUid', 'startedByName',
          'fighters', 'winnerUid', 'winnerName', 'mvpUid', 'mvpName', 'mvpKicks',
          'startedAtMs', 'endedAtMs', 'updatedAt'
        ])
        && data.id == 'current'
        && isValidId(data.groupId)
        && data.status in ['active', 'ended']
        && isValidId(data.startedByUid)
        && data.startedByName is string
        && data.startedByName.size() >= 1
        && data.startedByName.size() <= 24
        && data.fighters is list
        && data.fighters.size() <= 32
        && (data.fighters.size() == 0 || data.fighters[0] is map)
        && (!('winnerUid' in data) || (data.winnerUid is string && data.winnerUid.size() <= 128))
        && (!('winnerName' in data) || (data.winnerName is string && data.winnerName.size() <= 24))
        && (!('mvpUid' in data) || (data.mvpUid is string && data.mvpUid.size() <= 128))
        && (!('mvpName' in data) || (data.mvpName is string && data.mvpName.size() <= 24))
        && (!('mvpKicks' in data) || (data.mvpKicks is int && data.mvpKicks >= 0 && data.mvpKicks <= 999))
        && (data.startedAtMs is int || data.startedAtMs is float)
        && (!('endedAtMs' in data) || (data.endedAtMs is int || data.endedAtMs is float))
        && data.updatedAt is timestamp;
    }

    function isValidRoomKick(data, kickId) {
      return data.keys().hasAll([
          'id', 'kickerUid', 'kickerName', 'targetUid', 'targetName', 'kickType', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'kickerUid', 'kickerName', 'targetUid', 'targetName', 'kickType', 'createdAt'
        ])
        && isValidId(data.id)
        && data.id == kickId
        && isValidId(data.kickerUid)
        && data.kickerName is string
        && data.kickerName.size() >= 1
        && data.kickerName.size() <= 24
        && isValidId(data.targetUid)
        && data.targetName is string
        && data.targetName.size() >= 1
        && data.targetName.size() <= 24
        && data.kickerUid != data.targetUid
        && data.kickType is string
        && data.kickType in ['manual', 'host']
        && data.createdAt is timestamp;
    }

    function isValidDoorbell(data, uid) {
      return data.keys().hasAll(['uid', 'username', 'status', 'createdAt'])
        && data.keys().hasOnly(['uid', 'username', 'status', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == uid
        && data.username is string
        && data.username.size() >= 1
        && data.username.size() <= 24
        && data.status is string
        && data.status in ['ringing', 'accepted', 'denied']
        && data.createdAt is timestamp;
    }

    function isValidNpcRole(role) {
      return role is string && role in ['bartender', 'bouncer', 'dj', 'host'];
    }

    function isValidRoomNpc(data, npcId) {
      return data.keys().hasAll([
          'id', 'name', 'role', 'avatar', 'x', 'y', 'direction',
          'dialogueList', 'patrolPath', 'ownerId', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'role', 'avatar', 'x', 'y', 'direction',
          'dialogueList', 'patrolPath', 'ownerId', 'createdAt'
        ])
        && isValidId(data.id)
        && data.id == npcId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 24
        && isValidNpcRole(data.role)
        && isValidAvatar(data.avatar)
        && isValidCoord(data.x)
        && isValidCoord(data.y)
        && isValidDirection(data.direction)
        && data.dialogueList is list
        && data.dialogueList.size() <= 3
        && (data.dialogueList.size() == 0 || (data.dialogueList[0] is string && data.dialogueList[0].size() <= 120))
        && data.patrolPath is list
        && data.patrolPath.size() <= 12
        && (data.patrolPath.size() == 0 || (data.patrolPath[0] is map && isValidCoord(data.patrolPath[0].x) && isValidCoord(data.patrolPath[0].y)))
        && isValidId(data.ownerId)
        && data.createdAt is timestamp;
    }

    function isValidPlayer(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'isAdultConfirmed',
          'x', 'y', 'targetX', 'targetY',
          'direction', 'avatar', 'heldDrink', 'lastActive'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'motto', 'staffRole', 'isOnDuty',
          'isClubMember', 'isAdultConfirmed',
          'x', 'y', 'targetX', 'targetY',
          'direction', 'avatar', 'heldDrink', 'emote', 'emoteUntil',
          'team', 'spawnShieldUntil', 'lastKickAt',
          'stunnedUntil', 'stunImmuneUntil', 'lastActive'
        ])
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 24
        && (!('motto' in data) || (data.motto is string && data.motto.size() <= 50))
        && (!('staffRole' in data) || isValidStaffRole(data.staffRole))
        && (!('isOnDuty' in data) || data.isOnDuty is bool)
        && (!('isClubMember' in data) || data.isClubMember is bool)
        && data.isAdultConfirmed is bool
        && data.isAdultConfirmed == true
        && isValidPlayerCoord(data.x, data.y)
        && isValidPlayerCoord(data.targetX, data.targetY)
        && isValidDirection(data.direction)
        && isValidAvatar(data.avatar)
        && isValidDrink(data.heldDrink)
        && (!('emote' in data) || isValidEmote(data.emote))
        && (!('emoteUntil' in data) || ((data.emoteUntil is int || data.emoteUntil is float) && data.emoteUntil >= 0))
        && (!('team' in data) || isValidPlayerTeam(data.team))
        && (!('spawnShieldUntil' in data) || ((data.spawnShieldUntil is int || data.spawnShieldUntil is float) && data.spawnShieldUntil >= 0))
        && (!('lastKickAt' in data) || ((data.lastKickAt is int || data.lastKickAt is float) && data.lastKickAt >= 0))
        && (!('stunnedUntil' in data) || ((data.stunnedUntil is int || data.stunnedUntil is float) && data.stunnedUntil >= 0))
        && (!('stunImmuneUntil' in data) || ((data.stunImmuneUntil is int || data.stunImmuneUntil is float) && data.stunImmuneUntil >= 0))
        && data.lastActive is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['uid', 'displayName', 'text', 'kind', 'createdAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'isClubMember', 'staffRole', 'isOnDuty', 'text', 'kind', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 24
        && (!('isClubMember' in data) || data.isClubMember is bool)
        && (!('staffRole' in data) || isValidStaffRole(data.staffRole))
        && (!('isOnDuty' in data) || data.isOnDuty is bool)
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 500
        && data.kind is string
        && data.kind == 'chat'
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidFurnitureType(t) {
      return t is string && t in [
        'dj_console',
        'dj_speaker',
        'bar_counter',
        'bar_corner',
        'vip_sofa',
        'vip_table',
        'velvet_armchair',
