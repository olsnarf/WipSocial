        "groupId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "kickWarsMode": { "type": "string", "enum": ["ffa", "team"] },
        "kickWarsRange": { "type": "string", "enum": ["melee", "open"] },
        "matchActive": { "type": "boolean" },
        "redScore": { "type": "number" },
        "blueScore": { "type": "number" },
        "bannedUsers": { "type": "object" },
        "silencedUsers": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "name", "ownerId", "ownerName", "isPublic",
        "wallTheme", "floorTheme", "ambientDim", "createdAt"
      ]
