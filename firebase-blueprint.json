    },
    "RoomKickEvent": {
      "title": "RoomKickEvent",
      "description": "Manual Kick Wars elimination or host kick event causing knockback and lobby warp.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "kickerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "kickerName": { "type": "string", "minLength": 1, "maxLength": 24 },
        "targetUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetName": { "type": "string", "minLength": 1, "maxLength": 24 },
        "kickType": { "type": "string", "enum": ["manual", "host"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "kickerUid", "kickerName", "targetUid", "targetName", "kickType", "createdAt"]
    },
    "DoorbellRequest": {
      "title": "DoorbellRequest",
      "description": "Visitor doorbell entry request inside rooms/{roomId}/doorbells/{uid}.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 1, "maxLength": 24 },
        "status": { "type": "string", "enum": ["ringing", "accepted", "denied"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "status", "createdAt"]
    },
