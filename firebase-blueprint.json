{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Permanent player account, dual-currency wallet, 4-tier staff role, unlocks, Plaza Club VIP status, motto, and saved wardrobe.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID."
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9]{3,16}$",
          "description": "Unique permanent alphanumeric game username."
        },
        "motto": {
          "type": "string",
          "minLength": 0,
          "maxLength": 50,
          "description": "Customizable player motto shown on their profile and context card."
        },
        "staffRole": {
          "type": "string",
          "enum": ["user", "moderator", "gm", "admin", "owner", "super_admin"],
          "description": "Global Pixel Plaza 4-tier staff hierarchy (owner assigned to Snarf)."
        },
        "isOnDuty": {
          "type": "boolean",
          "description": "Staff utility toggle displaying overhead role badge on nametags and chat bubbles."
        },
        "isBanned": {
          "type": "boolean",
          "description": "Global account ban flag enforced across login and all rooms."
        },
        "tempBanUntilMs": {
          "type": "number",
          "description": "Epoch ms expiry for temporary bans (0 means permanent when isBanned is true)."
        },
        "banReason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160,
          "description": "Staff reason recorded for global or temporary ban."
        },
        "isMuted": {
          "type": "boolean",
          "description": "Global mute flag preventing public chat across all rooms."
        },
        "hasCustomWardrobe": {
          "type": "boolean",
          "description": "Owner-granted unlock for unrestricted hex color pickers, 70s Afro, and pattern overlays."
        },
        "hasSpecialtyFurni": {
          "type": "boolean",
          "description": "Owner-granted unlock for the 70s Retro & Specialty Furniture pack."
        },
        "eloRating": {
          "type": "number",
          "description": "Matchmaking league rating (default 1000)."
        },
        "turfRating": {
          "type": "number",
          "description": "Competitive Turf Wars rating (default 1000)."
        },
        "summonRoomId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "summonRoomName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 36
        },
        "summonBy": {
          "type": "string",
          "minLength": 0,
          "maxLength": 24
        },
        "summonAt": {
          "type": "number"
        },
        "credits": {
          "type": "number",
          "description": "Premium currency balance (starts at 50)."
        },
        "tokens": {
          "type": "number",
          "description": "Free earned currency balance (starts at 1000)."
        },
        "memberPoints": {
          "type": "number",
          "description": "Executive VIP Loyalty Member Points balance (starts at 250)."
        },
        "memberTenureMonths": {
          "type": "number",
          "description": "Cumulative months of VIP membership tenure for milestone rewards."
        },
        "claimedTierRewards": {
          "type": "array",
          "description": "List of claimed VIP milestone reward IDs (tier_1m, tier_3m, tier_6m)."
        },
        "ownedWardrobeIds": {
          "type": "array",
          "description": "List of unlocked WardrobeCatalogItem IDs owned by the player."
        },
        "isClubMember": {
          "type": "boolean",
          "description": "Whether the player holds an active Executive VIP membership."
        },
        "clubExpiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the player's Executive VIP membership expires."
        },
        "lastDailyClaim": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the most recent daily Tokens claim."
        },
        "lastClaimAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the most recent Token/reward claim."
        },
        "lastChatAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the most recent room chat message."
        },
        "avatar": {
          "type": "object",
          "description": "Saved The Aurelia isometric avatar appearance.",
          "properties": {
            "gender": { "type": "string", "enum": ["male", "female"] },
            "skin": { "type": "string", "maxLength": 7, "pattern": "^#[0-9a-fA-F]{6}$" },
            "hair": { "type": "string", "maxLength": 7, "pattern": "^#[0-9a-fA-F]{6}$" },
            "eyeColor": { "type": "string", "maxLength": 7, "pattern": "^#[0-9a-fA-F]{6}$" },
            "top": { "type": "string", "maxLength": 7, "pattern": "^#[0-9a-fA-F]{6}$" },
            "bottom": { "type": "string", "maxLength": 7, "pattern": "^#[0-9a-fA-F]{6}$" },
            "hairStyle": {
              "type": "string",
              "enum": [
                "buzz", "spiky", "bob", "long_waves", "pompadour",
                "undercut", "braids", "curls", "afro", "man_bun",
                "side_part", "curly_crop", "slick_back", "fade", "tousled",
                "pigtails", "afro_puff", "beach_waves", "pixie", "chignon",
                "high_ponytail", "curtain_bangs"
              ]
            },
            "hat": {
              "type": "string",
              "enum": [
                "none", "snapback", "beanie", "headphones", "fedora",
                "beret", "tophat", "crown", "halo", "fascinator", "cloche"
              ]
            },
            "topStyle": {
              "type": "string",
              "enum": [
                "tshirt", "hoodie", "suit", "leather", "tank", "crop",
                "polo", "turtleneck", "silk_shirt", "henley", "varsity",
                "tuxedo", "cashmere", "halter", "silk_blouse"
              ]
            },
            "bottomStyle": {
              "type": "string",
              "enum": ["jeans", "shorts", "skirt", "slacks", "chinos", "cargo", "midi_skirt"]
            },
            "shoeStyle": {
              "type": "string",
              "enum": ["sneakers", "boots", "loafers", "dress_shoes", "espadrilles", "heels", "oxfords"]
            },
            "shoeColor": { "type": "string", "maxLength": 7, "pattern": "^#[0-9a-fA-F]{6}$" },
            "clothPattern": {
              "type": "string",
              "enum": ["none", "tie_dye", "checkerboard", "camo", "starfield"]
            },
            "hairId": { "type": "string", "maxLength": 48 },
            "topId": { "type": "string", "maxLength": 48 },
            "bottomId": { "type": "string", "maxLength": 48 },
            "footwearId": { "type": "string", "maxLength": 48 },
            "accessoryId": { "type": "string", "maxLength": 48 },
            "auraEffect": { "type": "string", "enum": ["none", "diamond"] }
          },
          "required": ["skin", "hair", "top", "bottom", "hairStyle"]
        },
        "lastTradeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identifier of the most recent settled trade for atomic verification."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account was created."
        }
      },
      "required": [
        "uid",
        "username",
        "credits",
        "tokens",
        "lastDailyClaim",
        "avatar",
        "createdAt"
      ]
    },
    "InventoryItem": {
