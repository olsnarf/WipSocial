            "game_arena",
            "dark_slate_neon",
            "exposed_brick_club",
            "velvet_crimson",
            "midnight_penthouse",
            "cyber_grid"
          ]
        },
        "floorTheme": {
          "type": "string",
          "enum": [
            "veined_marble_gold",
            "art_deco_chevron",
            "emerald_terrazzo",
            "sapphire_carpet",
            "ivory_travertine",
            "oak_parquet",
            "cafe_terracotta",
            "sunlit_tile",
            "arena_turf",
