          "type": "boolean"
        },
        "catalogId": {
          "type": "string",
          "maxLength": 64
        },
        "isClubOnly": {
          "type": "boolean"
        },
        "variantSpec": {
          "type": "object"
        },
        "customSpriteSpec": {
          "type": "object"
        },
        "acquiredAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["itemId", "type", "name", "walkable", "isTradable", "acquiredAt"]
    },
    "FriendLink": {
      "title": "FriendLink",
      "description": "Friend relationship or pending friend request stored under users/{uid}/friends.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 3, "maxLength": 16, "pattern": "^[a-zA-Z0-9]{3,16}$" },
        "status": { "type": "string", "enum": ["pending_incoming", "pending_outgoing", "accepted"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "status", "updatedAt"]
    },
    "PlayerStatus": {
      "title": "PlayerStatus",
      "description": "Public online presence & current room indicator for friend Follow, Console, and Staff Warp.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 3, "maxLength": 16, "pattern": "^[a-zA-Z0-9]{3,16}$" },
        "currentRoomId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "currentRoomName": { "type": "string", "minLength": 1, "maxLength": 36 },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "currentRoomId", "currentRoomName", "isOnline", "lastSeen"]
    },
    "UsernameClaim": {
      "title": "UsernameClaim",
      "description": "Lowercase uniqueness lock document mapping a username to its owning UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 3, "maxLength": 16, "pattern": "^[a-zA-Z0-9]{3,16}$" },
        "authEmail": { "type": "string", "minLength": 16, "maxLength": 30, "pattern": "^[a-z0-9]{3,16}@lounge\\.local$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "authEmail", "createdAt"]
    },
    "TradeSession": {
      "title": "TradeSession",
      "description": "Real-time two-sided player-to-player trade session with two-step safety confirmation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "roomId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uidA": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "usernameA": { "type": "string", "minLength": 3, "maxLength": 16 },
        "uidB": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "usernameB": { "type": "string", "minLength": 3, "maxLength": 16 },
        "participantIds": { "type": "array" },
        "status": { "type": "string", "enum": ["open", "completed", "cancelled"] },
        "offerA": { "type": "object" },
        "offerB": { "type": "object" },
        "acceptA": { "type": "boolean" },
        "acceptB": { "type": "boolean" },
        "confirmA": { "type": "boolean" },
        "confirmB": { "type": "boolean" },
        "syncedA": { "type": "boolean" },
        "syncedB": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "roomId", "uidA", "usernameA", "uidB", "usernameB",
        "participantIds", "status", "offerA", "offerB",
        "acceptA", "acceptB", "confirmA", "confirmB", "syncedA", "syncedB",
        "createdAt", "updatedAt"
      ]
    },
    "PrivateChat": {
      "title": "PrivateChat",
      "description": "1-on-1 Pixel Console conversation metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 260, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "participantIds": { "type": "array" },
        "participantNames": { "type": "object" },
        "lastMessageText": { "type": "string", "minLength": 0, "maxLength": 500 },
        "lastSenderUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "readBy": { "type": "object" },
        "lastMessageAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "participantIds", "participantNames", "lastMessageText", "lastSenderUid", "readBy", "lastMessageAt"]
    },
    "PrivateMessage": {
      "title": "PrivateMessage",
      "description": "A single 1-on-1 message inside private_chats/{chatId}/messages.",
      "type": "object",
      "properties": {
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 24 },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderUid", "senderName", "text", "createdAt"]
    },
    "Room": {
      "title": "Room",
      "description": "Metadata, visual customization, floorplan, and moderation settings for a Pixel Plaza room.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 36 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 24 },
        "isPublic": { "type": "boolean" },
        "layoutType": {
